name: Build SbieDrv Only
on:
  push:
    branches: [ master ]  # 触发分支
  workflow_dispatch:       # 手动触发

jobs:
  build-driver:
    runs-on: windows-2022  # 匹配 VS2022 环境
    steps:
      - uses: actions/checkout@v4

      - name: Setup MSBuild
        uses: microsoft/setup-msbuild@v2
        with:
          msbuild-architecture: x64

      - name: Build SbieDrv (x64 Release)
        run: |
          msbuild Sandboxie\Sandboxie.sln `
            /t:SbieDrv `          # 仅构建 SbieDrv 项目
            /p:Configuration=Release `
            /p:Platform=x64 `
            /p:RestorePackages=false

      - name: Package Driver
        run: |
          mkdir driver-release
          copy Sandboxie\x64\Release\SbieDrv.sys driver-release\
          7z a SbieDrv-x64-Release.zip .\driver-release\*

      - name: Upload Driver Artifact
        uses: actions/upload-artifact@v4
        with:
          name: SbieDrv-x64
          path: SbieDrv-x64-Release.zip

      # （可选）自动发布到 Releases
      - name: Create Release
        if: github.event_name == 'push' && github.ref == 'refs/heads/master'
        uses: softprops/action-gh-release@v2
        with:
          files: SbieDrv-x64-Release.zip
          tag_name: drv-v${{ github.run_number }}
          name: SbieDrv Only Release v${{ github.run_number }}
          body: "Only SbieDrv.sys (x64 Release) from sandboxie-plus fork."
